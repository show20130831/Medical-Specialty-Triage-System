flowchart LR
    branch["短期分支"] --> pr["Pull Request"]
    pr --> required
    pr --> other
    subgraph required["必過檢查"]
        direction TB
        t1["API tests Ubuntu"]
        t2["API tests Windows"]
        t3["Smoke test"]
        t4["Docker build"]
    end
    subgraph other["其他工作（不阻擋）"]
        direction TB
        t5["Monitoring config"]
        t6["pip-audit（advisory）"]
    end
    required --> rule{"Ruleset"}
    rule -- "檢查失敗" --> fix["修正後推送"] --> required
    rule -- "分支落後 main" --> update["更新分支"] --> required
    rule -- "通過" --> main["合併到 main"]
    main -. "推送到 main 也觸發 CI" .-> required
